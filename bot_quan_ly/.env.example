# Copy thành bot_quan_ly/.env. Không commit file .env.
# Token bot mới (BotFather), khác bot noti-ip. Chỉ tiến trình này được cầm token.
TELEGRAM_BOT_TOKEN=
# Chat riêng với bot (số dương). Lệnh từ chat khác bị bỏ qua.
TELEGRAM_CHAT_ID=
# Mã nhập trên mỗi AutoHoc (ô Mã bí mật).
MA_KET_NOI=
# HTTP nhận báo cáo. Cloudflare Tunnel trỏ vào cổng này.
CONG=8787
# 0.0.0.0 = VM / máy khác trong LAN gọi được (cần mở firewall cổng CONG). Chỉ máy host: 127.0.0.1
LANG_NGHE=0.0.0.0
# Không nhận báo cáo quá số giây này thì nhắn một lần «máy im».
GIAY_IM=90
